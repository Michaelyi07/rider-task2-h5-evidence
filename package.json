{
  "name": "clawhunt-task2-h5",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Task 2/5 candidate-side H5 (React + Vite) with contract mock, unit tests and Playwright E2E. Synthetic data only.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "mock": "node mock/server.mjs",
    "dev:all": "concurrently -k -n h5,mock -c cyan,magenta \"npm:dev\" \"npm:mock\"",
    "build": "tsc --noEmit && vite build",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run test:unit && npm run test:e2e",
    "verify": "npm run build && npm run test:all",
    "evidence": "node scripts/collect-evidence.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
